#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift(File.expand_path('../lib', __dir__))

require 'mayhem/news/rss_importer'
require 'mayhem/events/ical_importer'

module Mayhem
  module Bin
    class ImportContentFromFeeds
      def self.run
        new.run
      end

      def run
        Mayhem::News::RssImporter.new.run
        Mayhem::Events::IcalImporterCLI.run
      end
    end
  end
end

Mayhem::Bin::ImportContentFromFeeds.run if $PROGRAM_NAME == __FILE__
