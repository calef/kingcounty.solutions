#!/usr/bin/env bash

set -euo pipefail

# Ensure SSH sessions always receive the UTF-8 locale and RuboCop cache defaults.
export LANG="${LANG:-C.UTF-8}"
export LANGUAGE="${LANGUAGE:-C.UTF-8}"
export LC_ALL="${LC_ALL:-C.UTF-8}"
export RUBOCOP_CACHE_ROOT="${RUBOCOP_CACHE_ROOT:-/work/tmp}"

USER_NAME="${DEV_CONTAINER_USER:-developer}"
PASSWORD="${DEV_CONTAINER_SSH_PASSWORD:-}"
OPENAI_PROFILE_SCRIPT="/etc/profile.d/dev-container-openai.sh"

if [ -n "${OPENAI_API_KEY:-}" ]; then
  # Make the API key available to login shells when provided.
  escaped_key="$(printf '%s' "$OPENAI_API_KEY" | sed 's/\\/\\\\/g; s/\"/\\\"/g')"
  cat >"$OPENAI_PROFILE_SCRIPT" <<EOF
#!/bin/sh
export OPENAI_API_KEY="$escaped_key"
EOF
  chmod 644 "$OPENAI_PROFILE_SCRIPT"
else
  rm -f "$OPENAI_PROFILE_SCRIPT"
fi

if ! id "$USER_NAME" >/dev/null 2>&1; then
  useradd -m -s /bin/bash "$USER_NAME"
fi

if [ -n "$PASSWORD" ]; then
  echo "${USER_NAME}:${PASSWORD}" | chpasswd
fi

# Start interactive shells in the workspace root. Ensure login shells also honor /work.
USER_HOME="$(getent passwd "$USER_NAME" | cut -d: -f6)"
if [ -n "$USER_HOME" ] && [ -d "$USER_HOME" ]; then
  ensure_workdir_in_shell() {
    local shell_file="$1"
    if [ -z "$shell_file" ]; then
      return 0
    fi
    if [ ! -f "$shell_file" ]; then
      touch "$shell_file"
      chown "$USER_NAME":"$USER_NAME" "$shell_file"
    fi
    if ! grep -q 'cd /work' "$shell_file"; then
      printf '\nif [ -d /work ]; then\n  cd /work\nfi\n' >> "$shell_file"
      chown "$USER_NAME":"$USER_NAME" "$shell_file"
    fi
  }

  ensure_workdir_in_shell "$USER_HOME/.bashrc"
  ensure_workdir_in_shell "$USER_HOME/.profile"
fi

mkdir -p /var/run/sshd
ssh-keygen -A >/dev/null

exec /usr/sbin/sshd -D -e
