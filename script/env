#!/usr/bin/env bash

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

export ROOT
export MISE_DATA_DIR="${MISE_DATA_DIR:-"$ROOT/.mise"}"
export PATH="$MISE_DATA_DIR/shims:$PATH"
export BUNDLE_APP_CONFIG="${BUNDLE_APP_CONFIG:-"$ROOT/.bundle"}"
export BUNDLE_PATH="${BUNDLE_PATH:-"$ROOT/vendor/bundle"}"
export BUNDLE_DISABLE_SHARED_GEMS="${BUNDLE_DISABLE_SHARED_GEMS:-1}"
export RUBOCOP_CACHE_ROOT="${RUBOCOP_CACHE_ROOT:-"$ROOT/tmp/rubocop_cache"}"

mkdir -p "$RUBOCOP_CACHE_ROOT"
